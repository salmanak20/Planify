# Planify legacy FastAPI backend - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# JWT Auth
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./planify.db

# Firebase
FIREBASE_PROJECT_ID=planify-23e25
FIREBASE_VERIFICATION_REQUIRED=true

# Option A - For local development: path to downloaded service account JSON
# FIREBASE_CREDENTIALS_PATH=C:\Users\YourName\Downloads\planify-firebase-adminsdk.json

# Option B - base64-encoded service account JSON string
# FIREBASE_CREDENTIALS_JSON=<base64-encoded-json-here>

# Smart Insights (server only; never put this in the Flutter app)
# Set through your hosting provider's secret manager in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
